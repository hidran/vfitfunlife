rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    function isValidDocument() {
      return (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*') &&
             request.resource.size < 100 * 1024 * 1024; // 100MB max
    }

    // User avatars
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Profile photos - Allow users to upload their own profile photos
    match /profile-photos/{userId}/{fileName} {
      allow write: if isOwner(userId) && isValidImage();
      allow read: if true;
    }

    // User avatars - Simplified avatar path
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Certifications - Allow providers to upload certifications
    match /certifications/{userId}/{fileName} {
      allow write: if isOwner(userId) && isValidDocument();
      allow read: if isAuthenticated();
    }

    // Provider portfolios - Allow providers to upload portfolio images
    match /portfolios/{userId}/{fileName} {
      allow write: if isOwner(userId) && isValidImage();
      allow read: if true;
    }

    // User uploads (receipts, etc.)
    match /users/{userId}/uploads/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
    }

    // Venue images (admin/staff only via Cloud Functions)
    match /venues/{venueId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Managed by Cloud Functions
    }

    // Instructor images
    match /instructors/{instructorId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Managed by Cloud Functions
    }

    // Event images
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Managed by Cloud Functions
    }

    // Challenge badges
    match /challenges/{challengeId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Admin only via Cloud Functions
    }

    // Review images (user can upload to their reviews)
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }

    // Streaming thumbnails
    match /streaming/{scheduleId}/{fileName} {
      allow read: if true;
      allow write: if false; // Admin only via Cloud Functions
    }

    // Public assets
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
