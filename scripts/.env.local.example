# Firebase Admin SDK Authentication
# Option 1: Path to service account key JSON file (recommended)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: JSON content of service account (useful for CI/CD)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: Firebase Project ID (helps when using application default credentials)
# FIREBASE_PROJECT_ID=vfit-funlife
