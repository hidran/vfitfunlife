rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    /**
     * Check if the user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if the current user is the owner of the document
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Get the role of the authenticated user
     */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /**
     * Get the full user data of the authenticated user
     */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Check if the authenticated user is a superadmin
     */
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    /**
     * Check if the authenticated user is an admin (superadmin or admin)
     */
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'admin'];
    }

    /**
     * Check if the authenticated user is a provider
     */
    function isProvider() {
      return isAuthenticated() && getUserRole() == 'provider';
    }

    /**
     * Check if the authenticated user is a customer
     */
    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }

    /**
     * Check if the user has a specific permission
     */
    function hasPermission(permission) {
      return isAuthenticated() && permission in getUserData().permissions;
    }

    /**
     * Check if user is staff (admin or superadmin)
     */
    function isStaff() {
      return isAdmin();
    }

    /**
     * Check if user is venue staff
     */
    function isVenueStaff(venueId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/venueStaff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/venueStaff/$(request.auth.uid)).data.venueId == venueId;
    }

    /**
     * Check if provider is the assigned instructor for a booking
     */
    function isAssignedProvider(bookingId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.instructorId == request.auth.uid;
    }

    /**
     * Validate user creation data
     */
    function isValidUserCreate() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'phone', 'fullName', 'avatarUrl', 'dateOfBirth',
        'role', 'userType', 'permissions', 'providerProfile', 'providerStatus',
        'isActive', 'isVip', 'isVerified',
        'vipExpiresAt', 'vipPlanId', 'stripeCustomerId', 'stripeSubscriptionId',
        'pointsBalance', 'walletBalance',
        'preferredLanguage', 'preferredSection', 'notificationsEnabled',
        'fcmTokens', 'referralCode', 'referredBy', 'referralCount',
        'createdAt', 'updatedAt', 'lastLoginAt', 'createdBy'
      ]);
    }

    /**
     * Validate user update data (customers and providers)
     */
    function isValidUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName', 'email', 'phone', 'bio', 'dateOfBirth', 'preferredLanguage',
        'preferredSection', 'avatarUrl', 'notificationsEnabled', 'fcmTokens',
        'updatedAt', 'lastLoginAt', 'phoneVerified', 'emailVerified',
        'socialLinks', 'notificationSettings', 'privacySettings', 'providerProfile', 'providerStatus',
        'theme'
      ]);
    }

    /**
     * Validate role update (admin only fields)
     */
    function isValidRoleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'userType']);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================

    match /users/{userId} {
      // Read rules
      allow read: if isOwner(userId) || 
                    isAdmin() || 
                    (isProvider() && resource.data.role == 'provider' && resource.data.userType != null);

      // Create rules - superadmin can create any user, new users can create their own profile
      allow create: if isSuperAdmin() || 
                       (isOwner(userId) &&
                        request.resource.data.role in ['customer', 'provider'] &&
                        request.resource.data.get('providerStatus', 'none') in ['none', 'pending'] &&
                        isValidUserCreate());

      // Update rules
      allow update: if (
        // Users can update their own basic profile
        (isOwner(userId) && isValidUserUpdate() && !isValidRoleUpdate() &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['providerStatus']) ||
          request.resource.data.providerStatus in ['none', 'pending']))
      ) || (
        // Superadmin can update anything
        isSuperAdmin()
      ) || (
        // Admin can update non-superadmin users and cannot change roles
        isAdmin() && 
        resource.data.role != 'superadmin' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
      );

      // Delete rules - superadmin only
      allow delete: if isSuperAdmin();

      // User subcollections
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId); // Mark as read
        allow create, delete: if false; // Only Cloud Functions can create/delete
      }

      match /pointsTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /userChallenges/{challengeId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /availability/{dateId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // AI assistant chats — owner reads; superadmin reads for support.
      // Writes happen only via Cloud Functions (admin SDK bypasses rules).
      match /chats/{chatId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId) || isSuperAdmin();
          allow write: if false;
        }
      }

      // AI usage counters — function-managed; superadmin may read.
      match /ai_usage/{dayId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    // ============================================
    // PROVIDER APPLICATIONS
    // ============================================

    match /providerApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // ROLE CHANGE LOGS (Admin only)
    // ============================================

    match /roleChangeLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // VERIFICATION LOGS (Admin only)
    // ============================================

    match /verificationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // USER STATUS LOGS (Admin only)
    // ============================================

    match /userStatusLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // VENUES COLLECTION
    // ============================================

    match /venues/{venueId} {
      // Public read
      allow read: if true;

      // Create: Admin or venue staff
      allow create: if isAdmin() || isVenueStaff(venueId);

      // Update: staff (admin or superadmin)
      allow update: if isAdmin();

      // Delete: superadmin only
      allow delete: if isSuperAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin() || isVenueStaff(venueId);
      }

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin() || isVenueStaff(venueId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;
      }

      match /staff/{staffId} {
        allow read: if isAdmin() || isVenueStaff(venueId);
        allow write: if isAdmin() || isVenueStaff(venueId);
      }
    }

    // ============================================
    // INSTRUCTORS/PROVIDERS COLLECTION
    // ============================================

    match /instructors/{instructorId} {
      // Public read for verified instructors
      allow read: if (resource.data.get('providerProfile', {}).get('isVerified', false) == true) ||
                    isAdmin() ||
                    (isAuthenticated() && request.auth.uid == resource.data.uid);

      // Create: admin, or the user creating their OWN unverified pending profile
      allow create: if isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.uid == request.auth.uid &&
         request.resource.data.get(['providerProfile', 'isVerified'], false) == false &&
         request.resource.data.get('applicationStatus', 'pending') == 'pending');

      // Update: admin can change anything; the owner may edit their profile but may
      // NOT change isVerified or applicationStatus (only admin verifies/rejects).
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.get(['providerProfile', 'isVerified'], false) ==
           resource.data.get(['providerProfile', 'isVerified'], false) &&
         request.resource.data.get('applicationStatus', 'pending') ==
           resource.data.get('applicationStatus', 'pending'));

      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;
      }

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/instructors/$(instructorId)).data.uid == request.auth.uid);
      }

      match /availability/{dateId} {
        allow read: if true;
        allow write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/instructors/$(instructorId)).data.uid == request.auth.uid);
      }
    }

    // ============================================
    // BOOKINGS COLLECTION
    // ============================================

    match /bookings/{bookingId} {
      // Read: Owner, assigned provider, or admin
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.instructorId == request.auth.uid ||
        isAdmin()
      );

      // Create: Customers can create their own bookings
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'venueId', 'serviceId', 'instructorId',
          'userName', 'userPhone', 'userEmail', 'venueName', 'venueAddress',
          'serviceName', 'instructorName', 'bookingType', 'serviceAddress',
          'scheduledAt', 'scheduledEndAt', 'durationMinutes', 'status',
          'originalPrice', 'discountAmount', 'homeServiceFee', 'finalPrice',
          'depositAmount', 'pointsUsed', 'pointsValue', 'pointsEarned',
          'promotionId', 'promotionCode', 'depositPaid', 'paymentStatus',
          'paymentMethod', 'stripePaymentIntentId', 'userNotes', 'internalNotes',
          'cancelledAt', 'cancelledBy', 'cancellationReason', 'refundAmount',
          'hasReviewed', 'reviewId', 'createdAt', 'updatedAt', 'confirmedAt', 'completedAt'
        ]);

      // Update: Owner (limited fields), assigned provider (status), or admin
      allow update: if isAuthenticated() && (
        // Admin can update all bookings
        isAdmin()
      ) || (
        // Customer can update their own booking (limited fields - mainly for cancellation)
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userNotes', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt'
        ])
      ) || (
        // Assigned provider can update status
        resource.data.instructorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'internalNotes'
        ])
      );

      // Delete: Superadmin only
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // CLASS BOOKINGS
    // ============================================

    match /classBookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================
    // FITNESS CLASSES
    // ============================================

    match /fitnessClasses/{classId} {
      allow read: if true;
      allow write: if isAdmin() || isVenueStaff(resource.data.venueId);

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============================================
    // EVENTS
    // ============================================

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /registrations/{registrationId} {
        allow read: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ============================================
    // SERVICE CATEGORIES
    // ============================================

    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // VIP PLANS
    // ============================================

    match /vipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CHALLENGES
    // ============================================

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // PROMOTIONS
    // ============================================

    match /promotions/{promotionId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================
    // STREAMING SCHEDULE
    // ============================================

    match /streamingSchedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CONFIGURATION (Admin only)
    // ============================================

    match /config/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================
    // SYSTEM SETTINGS (Superadmin only)
    // ============================================

    match /systemSettings/{settingId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // ADMIN COLLECTION (Deprecated - using users with role)
    // ============================================

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // VENUE STAFF
    // ============================================

    match /venueStaff/{staffId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == staffId || isAdmin());
      allow write: if isAdmin();
    }

    // ============================================
    // PAYMENTS
    // ============================================

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // Only Cloud Functions
      allow update: if isSuperAdmin();
      allow delete: if false; // Ledger-immutable
    }

    // ============================================
    // STRIPE CUSTOMERS
    // ============================================

    match /stripeCustomers/{customerId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // NOTIFICATIONS (Global)
    // ============================================

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // ANALYTICS (Admin only)
    // ============================================

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // AUDIT LOGS (Admin only)
    // ============================================

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // SYSTEM LOGS (admin action log — append-only)
    // ============================================

    match /systemLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // DELETED USERS (Superadmin only)
    // ============================================

    match /deletedUsers/{userId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // USER TYPES (Public read, admin write)
    // ============================================

    match /userTypes/{userTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // SERVICE TYPES (Public read, admin write)
    // ============================================

    match /serviceTypes/{serviceTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // HOME TRAINING SERVICES (Public catalog)
    // ============================================

    match /homeTrainingServices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // VIRTUAL PROGRAMS (Public catalog)
    // ============================================

    match /virtualPrograms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // TESTIMONIALS (Public read, admin write)
    // ============================================

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // TRANSACTIONS (Admin-only view of platform finances)
    // ============================================

    match /transactions/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions / admin SDK
    }

    // ============================================
    // CLIENTS (Provider's denormalized client roster)
    // ============================================

    match /clients/{clientId} {
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.providerId == request.auth.uid);
      allow write: if isAdmin() ||
                     (isAuthenticated() && request.resource.data.providerId == request.auth.uid);

      match /notes/{noteId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid);
      }
    }

    // ============================================
    // PROVIDERS COLLECTION (admin-side roster)
    // ============================================

    match /providers/{providerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
                       (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // USER TYPES (snake_case alias — admin CRUD)
    // ============================================

    match /user_types/{userTypeId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // AUDIT LOGS (snake_case — admin/superadmin write-once)
    // ============================================

    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}
