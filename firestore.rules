rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    /**
     * Check if the user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Check if the current user is the owner of the document
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Get the role of the authenticated user
     */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /**
     * Get the full user data of the authenticated user
     */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Check if the authenticated user is a superadmin
     */
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }

    /**
     * Check if the authenticated user is an admin (superadmin or admin)
     */
    function isAdmin() {
      return isAuthenticated() && getUserRole() in ['superadmin', 'admin'];
    }

    /**
     * Check if the authenticated user is a provider
     */
    function isProvider() {
      return isAuthenticated() && getUserRole() == 'provider';
    }

    /**
     * A provider a superadmin has approved. Anyone can create their own users doc
     * with role 'provider', so role alone proves nothing; providerStatus 'verified'
     * is only ever set server-side (clients may only self-set 'none'/'pending').
     */
    function isVerifiedProvider() {
      return isProvider() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('providerStatus', 'none') == 'verified';
    }

    /**
     * Check if the authenticated user is a customer
     */
    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }

    /**
     * Check if the user has a specific permission
     */
    function hasPermission(permission) {
      return isAuthenticated() && permission in getUserData().permissions;
    }

    /**
     * Check if user is staff (admin or superadmin)
     */
    function isStaff() {
      return isAdmin();
    }

    /**
     * Check if user is venue staff
     */
    function isVenueStaff(venueId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/venueStaff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/venueStaff/$(request.auth.uid)).data.venueId == venueId;
    }

    /**
     * Check if provider is the assigned instructor for a booking
     */
    function isAssignedProvider(bookingId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.instructorId == request.auth.uid;
    }

    /**
     * Validate user creation data
     */
    function isValidUserCreate() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'phone', 'fullName', 'avatarUrl', 'dateOfBirth',
        'role', 'userType', 'permissions', 'providerProfile', 'providerStatus',
        'isActive', 'isVip', 'isVerified',
        'vipExpiresAt', 'vipPlanId', 'stripeCustomerId', 'stripeSubscriptionId',
        'pointsBalance', 'walletBalance',
        'preferredLanguage', 'preferredSection', 'notificationsEnabled',
        'fcmTokens', 'referralCode', 'referredBy', 'referralCount',
        'createdAt', 'updatedAt', 'lastLoginAt', 'createdBy', 'isSuspended'
      ]) &&
      // A self-created profile may carry isSuspended only as false: the field is written on
      // creation so every user doc has it (P0-9), but suspension itself stays admin-only.
      request.resource.data.get('isSuspended', false) == false;
    }

    /**
     * Validate user update data (customers and providers)
     */
    function isValidUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName', 'email', 'phone', 'bio', 'dateOfBirth', 'preferredLanguage',
        'preferredSection', 'avatarUrl', 'notificationsEnabled', 'fcmTokens',
        // emailVerified is server-owned (syncEmailVerification); a client must not
        // be able to mark its own address verified.
        'updatedAt', 'lastLoginAt', 'phoneVerified',
        'socialLinks', 'notificationSettings', 'privacySettings', 'providerProfile', 'providerStatus',
        'theme'
      ]);
    }

    /**
     * Validate role update (admin only fields)
     */
    function isValidRoleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'userType']);
    }

    /**
     * The only two accounts allowed to hold role 'superadmin'. Rules cannot import code, so
     * this list is hardcoded here — it MUST be kept in sync with PROTECTED_SUPERADMIN_UIDS in
     * functions/src/lib/superadmins.ts (hidran@gmail.com, admin@vfit.com).
     */
    function isAllowedSuperadminUid(uid) {
      return uid in ['7MK6TgATIbhl3BkUksLNdGi7cMg1', 'KTNK3mIMHqg8JNOQiVyKioulORs1'];
    }

    /**
     * A write's resulting role is either not 'superadmin', or belongs to one of the two
     * allowed accounts. Nobody can promote any other uid to superadmin through the app.
     */
    function isValidSuperadminTarget(userId) {
      return request.resource.data.get('role', '') != 'superadmin' || isAllowedSuperadminUid(userId);
    }

    /**
     * True when the EXISTING document is a superadmin's — i.e. immutable through the app
     * except by its own owner editing their own ordinary profile fields.
     */
    function isExistingSuperadmin() {
      return resource.data.get('role', '') == 'superadmin';
    }

    /**
     * Fields a superadmin's own doc may never be changed to, by anyone including its owner:
     * role, permissions and every suspend/soft-delete flag.
     */
    function touchesProtectedSuperadminFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'permissions', 'isSuspended', 'suspendedAt', 'isDeleted', 'deletedAt']);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================

    match /users/{userId} {
      // Read rules
      allow read: if isOwner(userId) || 
                    isAdmin() || 
                    (isProvider() && resource.data.role == 'provider' && resource.data.userType != null);

      // Create rules - superadmin can create any user, new users can create their own profile.
      // Either way, a doc can only be created with role 'superadmin' for one of the two
      // allowed uids (isValidSuperadminTarget) — nobody can mint a new superadmin account.
      allow create: if isValidSuperadminTarget(userId) && (
        isSuperAdmin() ||
        (isOwner(userId) &&
         request.resource.data.role in ['customer', 'provider'] &&
         request.resource.data.get('providerStatus', 'none') in ['none', 'pending'] &&
         isValidUserCreate())
      );

      // Update rules.
      // A superadmin's own doc is a special case, checked first: only its owner may write it,
      // and never role, permissions, or any suspend/soft-delete flag — not by an admin, and
      // not by the other superadmin. Everything else keeps the existing behavior, with the
      // same "never mint a superadmin" guard as create.
      allow update: if isExistingSuperadmin()
        ? (isOwner(userId) && !touchesProtectedSuperadminFields())
        : (isValidSuperadminTarget(userId) && (
            (
              // Users can update their own basic profile
              (isOwner(userId) && isValidUserUpdate() && !isValidRoleUpdate() &&
               (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['providerStatus']) ||
                request.resource.data.providerStatus in ['none', 'pending']))
            ) || (
              // Superadmin can update anything else
              isSuperAdmin()
            ) || (
              // Admin can update non-superadmin users and cannot change roles
              isAdmin() &&
              resource.data.role != 'superadmin' &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
            )
          ));

      // Delete rules - superadmin only, and a superadmin account can never be deleted.
      allow delete: if isSuperAdmin() && resource.data.get('role', '') != 'superadmin';

      // User subcollections
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId); // Mark as read
        allow create, delete: if false; // Only Cloud Functions can create/delete
      }

      match /pointsTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /userChallenges/{challengeId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /availability/{dateId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // AI assistant chats — owner reads; superadmin reads for support.
      // Writes happen only via Cloud Functions (admin SDK bypasses rules).
      match /chats/{chatId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId) || isSuperAdmin();
          allow write: if false;
        }
      }

      // AI usage counters — function-managed; superadmin may read.
      match /ai_usage/{dayId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    // ============================================
    // PROVIDER APPLICATIONS
    // ============================================

    match /providerApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // ROLE CHANGE LOGS (Admin only)
    // ============================================

    match /roleChangeLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // VERIFICATION LOGS (Admin only)
    // ============================================

    match /verificationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // USER STATUS LOGS (Admin only)
    // ============================================

    match /userStatusLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // VENUES COLLECTION
    // ============================================

    match /venues/{venueId} {
      // Public read
      allow read: if true;

      // Create: Admin or venue staff
      allow create: if isAdmin() || isVenueStaff(venueId);

      // Update: staff (admin or superadmin)
      allow update: if isAdmin();

      // Delete: superadmin only
      allow delete: if isSuperAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin() || isVenueStaff(venueId);
      }

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isAdmin() || isVenueStaff(venueId);
      }

      // Reviews are written only by the submitReview callable (Admin SDK), which checks the
      // booking was delivered and allows one review per booking. A client-side create let
      // anyone post (and delete) unverified reviews that then counted in the rating.
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if false;
      }

      match /staff/{staffId} {
        allow read: if isAdmin() || isVenueStaff(venueId);
        allow write: if isAdmin() || isVenueStaff(venueId);
      }
    }

    // ============================================
    // INSTRUCTORS/PROVIDERS COLLECTION
    // ============================================

    match /instructors/{instructorId} {
      // Public read for verified instructors. The last clause matches the services rule's
      // reasoning below: ownership by path id, not by a `uid` field older/pending provider
      // docs may lack, so a pending or legacy provider can always load their own hours
      // (fetchMyAvailability) — the same doc updateMyAvailability already lets them save.
      allow read: if (resource.data.get('providerProfile', {}).get('isVerified', false) == true) ||
                    isAdmin() ||
                    (isAuthenticated() && request.auth.uid == resource.data.uid) ||
                    (isAuthenticated() && request.auth.uid == instructorId);

      // Create: admin, or the user creating their OWN unverified pending profile
      allow create: if isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.uid == request.auth.uid &&
         request.resource.data.get(['providerProfile', 'isVerified'], false) == false &&
         request.resource.data.get('applicationStatus', 'pending') == 'pending');

      // Update: admin can change anything; the owner may edit their profile but may
      // NOT change isVerified or applicationStatus (only admin verifies/rejects).
      // Ownership by `uid` field or by path id, as for read: older provider docs lack a
      // `uid`, and their owners must still be able to set their own location (D4).
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         (resource.data.get('uid', null) == request.auth.uid || request.auth.uid == instructorId) &&
         request.resource.data.get(['providerProfile', 'isVerified'], false) ==
           resource.data.get(['providerProfile', 'isVerified'], false) &&
         request.resource.data.get('applicationStatus', 'pending') ==
           resource.data.get('applicationStatus', 'pending'));

      allow delete: if isAdmin();

      // Reviews are written only by the submitReview callable (Admin SDK), which checks the
      // booking was delivered and allows one review per booking. A client-side create let
      // anyone post (and delete) unverified reviews that then counted in the rating.
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if false;
      }

      match /services/{serviceId} {
        allow read: if true;
        // The service path already scopes the write to the authenticated uid, so
        // ownership doesn't depend on a legacy instructor doc carrying a matching uid
        // (older verified providers have a missing/stale one). The caller must be an
        // approved provider, not merely one who gave themselves role 'provider'.
        allow write: if isAdmin() ||
          (request.auth != null && request.auth.uid == instructorId && isVerifiedProvider());
      }

      // Date exceptions to the weekly hours. Public: anyone may see when a provider is off.
      // Written only by the updateMyAvailability callable, which validates them.
      match /availability/{dateId} {
        allow read: if true;
        allow write: if false;
      }

      // Provider-day locks taken by createBooking's availability check. Server-only.
      match /bookingDays/{date} {
        allow read, write: if false;
      }
    }

    // ============================================
    // BOOKINGS COLLECTION
    // ============================================

    // Every booking state transition runs through a Cloud Function using the Admin SDK,
    // which bypasses these rules. They are therefore a deny-by-default backstop, not the
    // enforcement layer. See docs/superpowers/specs/2026-08-08-booking-manual-payment-design.md §10
    match /bookings/{bookingId} {
      // Read: Owner, assigned trainer, or admin
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.instructorId == request.auth.uid ||
        isAdmin()
      );

      // Create: DENIED for clients. Bookings are created only by the createBooking
      // callable, which resolves the service and computes pricing server-side.
      //
      // The previous rule let a client write the document directly, and its allowlist
      // included originalPrice / discountAmount / homeServiceFee / finalPrice — so a
      // hand-crafted request could book at finalPrice: 0.
      allow create: if false;

      // Update: clients may touch only their own notes. Status, amounts and the payment
      // confirmation are not writable from any client — not by the customer, and not by
      // the trainer (who could otherwise self-confirm a payment for any amount).
      allow update: if isAuthenticated() && (
        isAdmin()
      ) || (
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userNotes', 'updatedAt'
        ]) &&
        // Same cap as createBooking's sanitizeUserNotes.
        (request.resource.data.get('userNotes', null) == null ||
          (request.resource.data.userNotes is string &&
           request.resource.data.userNotes.size() <= 500))
      );

      // Delete: Superadmin only
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // CLASS BOOKINGS
    // ============================================

    match /classBookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================
    // FITNESS CLASSES
    // ============================================

    match /fitnessClasses/{classId} {
      allow read: if true;
      allow write: if isAdmin() || isVenueStaff(resource.data.venueId);

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============================================
    // EVENTS
    // ============================================

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /registrations/{registrationId} {
        allow read: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ============================================
    // SERVICE CATEGORIES
    // ============================================

    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // VIP PLANS
    // ============================================

    match /vipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CHALLENGES
    // ============================================

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // PROMOTIONS
    // ============================================

    match /promotions/{promotionId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================
    // STREAMING SCHEDULE
    // ============================================

    match /streamingSchedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // CONFIGURATION (Admin only)
    // ============================================

    match /config/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================
    // SYSTEM SETTINGS (Superadmin only)
    // ============================================

    // Pilot gate targets drive the Gate 1 banner on /admin/metrics, which is served to
    // admin as well as superadmin — so a superadmin-only read would break the page's
    // primary element for plain admins. Writes stay superadmin.
    match /systemSettings/pilotGates {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // platform/settings backs /admin/settings (commission, currency, support contacts,
    // maintenance mode). It had NO rule at all, so deny-by-default meant the page could
    // neither read nor save — a settings UI pointed at a document nobody could touch.
    // Read is admin-wide because commission and currency describe how the platform bills;
    // writing them is a financial change, so it stays superadmin.
    match /platform/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Shared exercise library. Readable by anyone signed in (clients see the movements in
    // their scheda); written only by the seed callable.
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Recruitment leads from the public /diventa-trainer page.
    //
    // Writes go exclusively through the submitTrainerLead callable, which validates the
    // shape and caps volume per IP. A public create rule here would make the collection
    // world-writable — the one thing an unauthenticated form must not do.
    match /trainer_leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-IP submission counters for the lead form. Function-only.
    match /lead_throttle/{key} {
      allow read, write: if false;
    }

    // Computed nightly by Cloud Functions; never writable from a client.
    match /metrics_daily/{dateKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The nightly metrics job's internal rollup (P2-2). Holds per-client completion times,
    // so no client reads it; Cloud Functions bypass rules.
    match /metrics_state/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // ADMIN COLLECTION (Deprecated - using users with role)
    // ============================================

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // VENUE STAFF
    // ============================================

    match /venueStaff/{staffId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == staffId || isAdmin());
      allow write: if isAdmin();
    }

    // ============================================
    // PAYMENTS
    // ============================================

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // Only Cloud Functions
      allow update: if isSuperAdmin();
      allow delete: if false; // Ledger-immutable
    }

    // ============================================
    // STRIPE CUSTOMERS
    // ============================================

    match /stripeCustomers/{customerId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // NOTIFICATIONS (Global)
    // ============================================

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // ANALYTICS (Admin only)
    // ============================================

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // The camelCase `auditLogs` collection is gone — its contents were folded into
    // `audit_logs` (see the rule near the end of this file) by migrateAuditLogs. Two
    // collections recording the same fact in different shapes meant every "who changed
    // what" question had to be asked twice. Deliberately left with no rule so any
    // straggler write is denied rather than quietly reviving the split.

    // ============================================
    // SYSTEM LOGS (admin action log — append-only)
    // ============================================

    match /systemLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // DELETED USERS (Superadmin only)
    // ============================================

    match /deletedUsers/{userId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ============================================
    // USER TYPES (Public read, admin write)
    // ============================================

    match /userTypes/{userTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // SERVICE TYPES (Public read, admin write)
    // ============================================

    match /serviceTypes/{serviceTypeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // HOME TRAINING SERVICES (Public catalog)
    // ============================================

    match /homeTrainingServices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // VIRTUAL PROGRAMS (Public catalog)
    // ============================================

    match /virtualPrograms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // TESTIMONIALS (Public read, admin write)
    // ============================================

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // TRANSACTIONS (Admin-only view of platform finances)
    // ============================================

    match /transactions/{id} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions / admin SDK
    }

    // ============================================
    // CLIENTS (Provider's denormalized client roster)
    // ============================================

    match /clients/{clientId} {
      // The client themselves may read their own relationship document — P2-5 gives them a
      // "Le mie schede" view, which has to resolve their own clientId first.
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.providerId == request.auth.uid) ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() ||
                     (isAuthenticated() && request.resource.data.providerId == request.auth.uid);

      match /notes/{noteId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid);
      }
      // Workout plans. The owning provider and staff have full access; the client may read
      // ONLY published plans — a draft is the trainer's working copy, and showing it would
      // undermine the human review that keeps AI output from reaching anyone unchecked.
      match /trainingPrograms/{planId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid) ||
          (isAuthenticated() &&
           get(/databases/$(database)/documents/clients/$(clientId)).data.userId == request.auth.uid &&
           resource.data.status == 'published');
        allow write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid);
      }

      // Training progress is the CLIENT's record of what they actually did, so unusually
      // for this codebase they are the writer. The trainer reads it but must not author it.
      match /planProgress/{progressId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid) ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.userId == request.auth.uid);
        allow write: if isAuthenticated() &&
          get(/databases/$(database)/documents/clients/$(clientId)).data.userId == request.auth.uid;
      }

      match /goals/{goalId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid);
      }
      match /trainingPrograms/{programId} {
        allow read, write: if isAdmin() ||
          (isAuthenticated() && get(/databases/$(database)/documents/clients/$(clientId)).data.providerId == request.auth.uid);
      }
      // NOTE: the former clients/{clientId}/dietPlans and clients/{clientId}/recipes blocks
      // were removed in P2-6. Diet plans are gone entirely (they were personalised nutrition
      // advice, which this platform must not give), and recipes moved to the top-level
      // `recipes` collection below — a recipe is owned, not addressed to a client.
    }

    // ============================================
    // RECIPES (P2-6 — generic suggestions, owned, shareable)
    // ============================================
    // A recipe belongs to whoever generated it and is NOT addressed to any client: there is
    // deliberately no clientId field. Sharing grants read access to named users and is the
    // human review gate — P2-5 needed draft/publish because a plan was born attached to a
    // client; a recipe is born attached to nobody.
    //
    // NOTE ON QUERIES (spec §6.4): list rules are evaluated against the QUERY. A trainer
    // listing what they shared with a client MUST also constrain ownerUid == their own uid;
    // `sharedWithUserIds array-contains <clientUid>` alone is denied, because the array value
    // is the client's uid while this rule tests the caller's.
    match /recipes/{recipeId} {
      allow get, list: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid) ||
        (isAuthenticated() && request.auth.uid in resource.data.sharedWithUserIds);

      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.sharedWithUserIds.size() == 0;

      allow update: if isAdmin() ||
        (isAuthenticated() &&
         resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         request.resource.data.sharedWithUserIds.size() <= 50);

      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
    }

    // ============================================
    // PROVIDERS COLLECTION (admin-side roster)
    // ============================================

    match /providers/{providerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
                       (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // CONVERSATIONS (client ↔ trainer chat) — Phase C of
    // docs/plans/2026-09-29-communication-booking-plan.md
    // ============================================
    //
    // conversations/{minUid_maxUid}: participantIds [minUid, maxUid] (sorted), participants
    // { uid: { name, photoUrl } }, lastMessage/lastMessageAt/lastSenderId, unread { uid: n },
    // optional bookingId. The id is deterministic so "Message" never makes a duplicate.
    //
    // Who writes what:
    //  - a participant CREATES the doc (with its first message, in one batch);
    //  - the onChatMessageCreated trigger (admin SDK) maintains lastMessage*, unread[other]
    //    and the push throttle (lastPushAt);
    //  - a participant may only reset their OWN unread count to 0 and refresh their OWN
    //    participants entry.

    /** participantIds is exactly [a, b], sorted, and the doc id is `${a}_${b}`. */
    function isValidConversationKey(conversationId, ids) {
      return ids is list && ids.size() == 2 &&
        ids[0] is string && ids[1] is string &&
        ids[0] < ids[1] &&
        conversationId == ids[0] + '_' + ids[1];
    }

    /**
     * Anti-spam: a conversation must involve a professional. Customers can open a chat
     * with a provider (or staff); providers and staff can open one with anyone.
     */
    function canStartChatWith(otherUid) {
      // The other side must be a real user — a stale or typed `/chat/<x>` link must not open
      // a conversation with nobody.
      return exists(/databases/$(database)/documents/users/$(otherUid)) && (
        isProvider() || isAdmin() ||
        get(/databases/$(database)/documents/users/$(otherUid)).data.get('role', '')
          in ['provider', 'admin', 'superadmin']
      );
    }

    function isValidConversationCreate(conversationId) {
      let data = request.resource.data;
      let ids = data.participantIds;
      return data.keys().hasAll(['participantIds', 'participants', 'createdAt', 'lastMessageAt']) &&
        data.keys().hasOnly(['participantIds', 'participants', 'createdAt', 'lastMessageAt', 'bookingId']) &&
        isValidConversationKey(conversationId, ids) &&
        request.auth.uid in ids &&
        data.participants is map &&
        data.participants.keys().hasOnly(ids) &&
        data.createdAt == request.time &&
        data.lastMessageAt == request.time &&
        (!('bookingId' in data) || (data.bookingId is string && data.bookingId.size() <= 128)) &&
        canStartChatWith(ids[0] == request.auth.uid ? ids[1] : ids[0]);
    }

    /** The only client update: my unread back to 0 and/or my own participants entry. */
    function isValidConversationSelfUpdate() {
      let uid = request.auth.uid;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let unreadAfter = request.resource.data.get('unread', {});
      let participantsAfter = request.resource.data.get('participants', {});
      return changed.hasOnly(['unread', 'participants']) &&
        unreadAfter.diff(resource.data.get('unread', {})).affectedKeys().hasOnly([uid]) &&
        (!(uid in unreadAfter) || unreadAfter[uid] == 0) &&
        participantsAfter.diff(resource.data.get('participants', {})).affectedKeys().hasOnly([uid]);
    }

    match /conversations/{conversationId} {
      // get: a participant — also for a conversation that does not exist yet, so the thread
      // screen can listen on it before the first message creates it.
      allow get: if isAuthenticated() && (
        resource == null
          ? request.auth.uid in conversationId.split('_')
          : request.auth.uid in resource.data.participantIds
      );
      // list: the inbox query must filter `participantIds array-contains <my uid>`.
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && isValidConversationCreate(conversationId);
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds &&
        isValidConversationSelfUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // getAfter: the first message is written in the same batch that creates the
        // conversation.
        allow create: if isAuthenticated() &&
          request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
        // Messages are immutable: nobody edits or deletes one (not even the sender).
        allow update, delete: if false;
      }
    }

    // ============================================
    // USER TYPES (snake_case alias — admin CRUD)
    // ============================================

    match /user_types/{userTypeId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Background admin jobs (bulk user delete). Written only by Cloud Functions; the
    // superadmin reads one to follow its progress.
    match /adminJobs/{jobId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ============================================
    // AUDIT LOGS (snake_case — admin/superadmin write-once)
    // ============================================

    match /audit_logs/{logId} {
      allow read:   if isAdmin();
      // bulk_*/single_* ids are reserved for the server (writeAuditLogOnce, keyed by
      // job/uid or uid/timestamp): a client pre-creating one would make the real write
      // silently no-op on ALREADY_EXISTS, deleting the user with no audit entry to show
      // for it.
      allow create: if isAdmin() && !logId.matches('(bulk|single)_.*');
      allow update: if false;
      allow delete: if false;
    }
  }
}
