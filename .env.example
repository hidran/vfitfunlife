# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Web push (FCM): Firebase console > Project settings > Cloud Messaging > Web Push certificates.
# One key pair per Firebase project (staging and prod differ). Empty = web push disabled.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=V Fitness

# Search Console: the `content` value of the HTML-tag verification method
# (Search Console > Settings > Ownership verification > HTML tag). Optional — when empty the
# meta tag is omitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Development
NEXT_PUBLIC_USE_EMULATORS=false
