{
  // Example (Standard Edition):
  //
  // "indexes": [
  //   {
  //     "collectionGroup": "widgets",
  //     "queryScope": "COLLECTION",
  //     "fields": [
  //       { "fieldPath": "foo", "arrayConfig": "CONTAINS" },
  //       { "fieldPath": "bar", "mode": "DESCENDING" }
  //     ]
  //   },
  //
  //  "fieldOverrides": [
  //    {
  //      "collectionGroup": "widgets",
  //      "fieldPath": "baz",
  //      "indexes": [
  //        { "order": "ASCENDING", "queryScope": "COLLECTION" }
  //      ]
  //    },
  //   ]
  // ]
  //
  // Example (Enterprise Edition):
  //
  // "indexes": [
  //   {
  //     "collectionGroup": "reviews",
  //     "queryScope": "COLLECTION_GROUP",
  //     "apiScope": "MONGODB_COMPATIBLE_API",
  //     "density": "DENSE",
  //     "multikey": false,
  //     "fields": [
  //       { "fieldPath": "baz", "mode": "ASCENDING" }
  //     ]
  //   },
  //   {
  //     "collectionGroup": "items",
  //     "queryScope": "COLLECTION_GROUP",
  //     "apiScope": "MONGODB_COMPATIBLE_API",
  //     "density": "SPARSE_ANY",
  //     "multikey": true,
  //     "fields": [
  //       { "fieldPath": "baz", "mode": "ASCENDING" }
  //     ]
  //   },
  // ]
  "indexes": [
    {
      "collectionGroup": "instructors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "providerProfile.isVerified", "order": "ASCENDING" },
        { "fieldPath": "providerProfile.specialties", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "providerProfile.isVerified", "order": "ASCENDING" },
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "role", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "transactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    // P1-4 (getAdminDashboardStats' monthlyRevenue): getAggregateFromServer(sum('amount'))
    // over this exact filter shape rejects with FAILED_PRECONDITION even though the index right
    // above already serves the plain getDocs() version fine — a sum() additionally needs the
    // summed field itself present in the index. Confirmed live against staging. Needs
    // `firebase deploy --only firestore:indexes`; sumOrFallback (src/lib/firebase/firestore.ts)
    // covers the gap with a getDocs()+reduce fallback until this is built.
    {
      "collectionGroup": "transactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" },
        { "fieldPath": "amount", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "instructorId", "order": "ASCENDING" },
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledEndAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "instructorId", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "completionReminderSentAt", "order": "ASCENDING" },
        { "fieldPath": "scheduledEndAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "paymentConfirmation.clientResponse", "order": "ASCENDING" },
        { "fieldPath": "paymentConfirmation.confirmedByTrainerAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "instructorId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "DESCENDING" }
      ]
    },
    // P1-3 (getProviderDashboardStats' today/week counts): discovered live against staging
    // that this query — instructorId ==, status IN [...], scheduledAt range — already needs a
    // composite index for a *plain* getDocs() too (an `in` filter combined with a range isn't
    // automatically indexed), and the index right above it, built DESCENDING for a different
    // (working) query, doesn't satisfy it. `getProviderDashboardStats` had no try/catch, so
    // every provider's today/week counts (and the identically-shaped month-earnings sum below)
    // have been silently throwing and rendering as zero — a pre-existing bug, not introduced by
    // switching to getCountFromServer, just found while doing it. Needs
    // `firebase deploy --only firestore:indexes`.
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "instructorId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "ASCENDING" }
      ]
    },
    // Same shape, plus `finalPrice`: getAggregateFromServer(sum('finalPrice')) for the
    // month-earnings query needs the summed field in the index too (see the transactions
    // sum index above for the same rule). sumOrFallback/countOrFallback
    // (src/lib/firebase/firestore.ts) fall back to a getDocs()+reduce answer until both this
    // and the index above are built.
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "instructorId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "scheduledAt", "order": "ASCENDING" },
        { "fieldPath": "finalPrice", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sharedWithUserIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerUid", "order": "ASCENDING" },
        { "fieldPath": "sharedWithUserIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    // getProviderClients() in src/lib/firebase/provider.ts. This index was missing, so that
    // query failed with FAILED_PRECONDITION for every provider and the roster silently came
    // back empty — the store swallows the error. Found while smoke-testing the P2-6 share
    // picker, which needs the roster to offer anyone to share with.
    {
      "collectionGroup": "clients",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "providerId", "order": "ASCENDING" },
        { "fieldPath": "lastVisit", "order": "DESCENDING" }
      ]
    },
    // getProviderDashboardStats' newClients count (src/lib/firebase/provider.ts): a different
    // field pair than the index above (firstVisit, not lastVisit), and just as missing — this
    // query has been silently throwing and rendering newClients as zero since it was written,
    // for a plain getDocs() every bit as much as for the getCountFromServer() it was rewritten
    // to (confirmed live against staging: both fail identically). countOrFallback
    // (src/lib/firebase/firestore.ts) can't rescue this one — its getDocs() fallback needs the
    // same index. Needs `firebase deploy --only firestore:indexes`.
    {
      "collectionGroup": "clients",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "providerId", "order": "ASCENDING" },
        { "fieldPath": "firstVisit", "order": "ASCENDING" }
      ]
    },
    // Category search. categoryIds holds the leaf AND its ancestors, so one
    // array-contains filters at any depth of the tree — expanding a group into leaves at
    // query time would hit array-contains-any's 30-value ceiling exactly as the catalogue
    // grows. Shipped in phase 1, one deploy before the query that needs it, so the index
    // is built by the time search flips over.
    {
      "collectionGroup": "instructors",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "providerProfile.isVerified", "order": "ASCENDING" },
        { "fieldPath": "categoryIds", "arrayConfig": "CONTAINS" }
      ]
    },
    // Serves two queries on the same shape: findRunningBulkDelete in
    // src/lib/firebase/bulkDelete.ts (the caller's latest unfinished bulk-delete job, so a
    // reload mid-job brings the progress banner back) and adminBulkDeleteUsers's
    // one-job-per-actor guard in functions/src/users/bulkDelete.ts (refuses a second bulk
    // delete while one is already queued/running for the same actor).
    {
      "collectionGroup": "adminJobs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "actorUid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
    // mergeServiceCategories runs a collection-group query on services.categoryId. That
    // needs NO composite entry — Firestore maintains single-field indexes at collection
    // GROUP scope automatically, and declaring one here is rejected outright as
    // unnecessary.
  ],
  "fieldOverrides": []
}