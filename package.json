{
  "name": "vfit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_USE_EMULATORS=true next dev",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "emulators:persist": "firebase emulators:start --only auth,firestore,functions,storage --import=./.emulator-data --export-on-exit",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy:functions": "firebase deploy -P production --only functions",
    "deploy:rules": "firebase deploy -P production --only firestore:rules,storage",
    "deploy:hosting": "npm run build && firebase deploy -P production --only hosting",
    "seed:users": "npx ts-node --transpile-only scripts/seed-users.ts",
    "seed:demo": "node scripts/seed-demo-data.js",
    "seed:demo:clear": "node scripts/seed-demo-data.js --clear",
    "seed:quick": "node scripts/seed-quick.js",
    "mobile:build": "next build",
    "mobile:sync": "cap sync",
    "mobile:copy": "cap copy",
    "mobile:ios": "npm run mobile:build && cap sync ios",
    "mobile:android": "npm run mobile:build && cap sync android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:run:ios": "cap run ios",
    "mobile:run:android": "cap run android",
    "build:staging": "dotenv -e .env.staging -- next build",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "deploy:staging": "npm run build:staging && firebase deploy -P staging --only hosting,firestore,storage",
    "deploy:staging:functions": "firebase deploy -P staging --only functions",
    "deploy:prod": "npm run build && firebase deploy -P production --only hosting,firestore,storage"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@hookform/resolvers": "^5.2.2",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "^5.90.20",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "framer-motion": "^12.29.2",
    "geofire-common": "^6.0.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "use-pull-to-refresh": "^2.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "dotenv-cli": "^8.0.0"
  }
}
