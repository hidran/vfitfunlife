# E2E / emulator-only configuration.
#
# The project id here MUST match the one the emulator suite runs under
# (`.firebaserc` default -> vfit-funlife) and the one scripts/seed-emulator.mjs
# writes to. `.env.local` points at vfit-app-staging, which is why
# `npm run dev:emulator` could never call a Cloud Function: the functions
# emulator serves /{projectId}/{region}/{fn}, so every callable 404'd and
# registration silently left the user without a Firestore profile.
#
# The credentials are deliberately fake. Everything is emulated, and a fake key
# means a misconfigured run fails loudly instead of quietly reaching a real
# Firebase project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vfit-funlife
NEXT_PUBLIC_FIREBASE_API_KEY=emulator-fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vfit-funlife.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vfit-funlife.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:emulator
NEXT_PUBLIC_FIREBASE_REGION=europe-west1
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
